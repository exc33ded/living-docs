#!/bin/sh
# Install: copy to .git/hooks/post-commit and chmod +x (see README). After each commit you make yourself, runs
# /update-docs and /update-readme in the background (on Sonnet) and leaves the doc edits uncommitted for review.
# Output goes to .git/update-docs.log.

[ -n "$CLAUDECODE" ] && exit 0            # inside Claude Code the PostToolUse hook handles it
command -v claude >/dev/null || exit 0
git diff-tree --no-commit-id --name-only -r HEAD | grep -qv '^docs/' || exit 0   # docs-only commit

nohup claude -p "Run the update-docs skill, then the update-readme skill. Skip screenshots." \
  --model sonnet \
  --permission-mode acceptEdits \
  --allowedTools "Bash(git log:*)" "Bash(git diff:*)" "Bash(git rev-parse:*)" "Bash(git ls-files:*)" Read Edit Write Glob Grep \
  > .git/update-docs.log 2>&1 &
